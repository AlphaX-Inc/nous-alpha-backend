# PayPay × Nous Alpha backend env

# Listen port (default 3001)
PORT=3001

# Stub-only mode (default false). When true, ignores ANTHROPIC_API_KEY and
# always serves stub data. Useful for design demos.
STUB_ONLY=false

# Anthropic API key — when set (and STUB_ONLY=false), the backend runs the
# 12 personas live via the Claude Agent SDK.
ANTHROPIC_API_KEY=

# Cache TTL for live-mode results (ms). Default 10 minutes.
CACHE_TTL_MS=600000
